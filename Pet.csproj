<Project Sdk="Microsoft.NET.Sdk">
  <!-- 桌宠本体：net48 / WinExe，无 NuGet 依赖。
       编译：dotnet build Pet.csproj -c Release
       产物：build\pet\Pet.exe（再复制到根目录） -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <AssemblyName>Pet</AssemblyName>
    <RootNamespace>PetApp</RootNamespace>
    <LangVersion>7.3</LangVersion>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <!-- 版本信息：改版本只改这里（PetSettings.csproj 里有一份同名副本，两处要一起改） -->
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <InformationalVersion>1.0.0</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <AssemblyTitle>Q Pet</AssemblyTitle>
    <Product>Q Pet</Product>
    <Company>Q Pet contributors</Company>
    <Copyright>MIT License · 2026 Q Pet contributors</Copyright>
    <DebugType>none</DebugType>
    <Optimize>true</Optimize>
    <ApplicationIcon>pet.ico</ApplicationIcon>
    <OutputPath>build\pet\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="pet.cs" />
    <Compile Include="Program.cs" />
    <Reference Include="System.Drawing" />
  </ItemGroup>
  <ItemGroup>
    <!-- 别人电脑上只要装了 .NET SDK、没装 .NET Framework 4.8 开发包时，
         靠这个包提供 net48 的引用程序集，dotnet build 才不会报
         「找不到 .NETFramework,Version=v4.8 的引用程序集」。本机已装开发包，有它也无副作用。 -->
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>
</Project>
