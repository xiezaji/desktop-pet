 "voices": [
  {
   "text": "今天又轮到谁粉身碎骨了呢？",
   "file": "voices/今天又轮到谁粉身碎骨了呢？.mp3"
  },
  {
   "text": "别急别急，人人有份~",
   "file": "voices/别急别急，人人有份~.mp3"
  },
  {
   "text": "哈？你确定？我到底是干了什么，才让你觉得我会一心一意守在你身边，为你当忠诚的小卫兵？后悔了？我已经答应了，这可是你自己选的，“博士”。",
   "file": "voices/哈？你确定？我到底是干了什么，才让你觉得我会一心一意守在你身边，为你当忠诚的小卫兵？后悔了？我已经答应了，这可是你自己选的，“博士”。.mp3"
  },
  {
   "text": "喜欢我指甲的颜色嘛，猜猜看是用什么染的？",
   "file": "voices/喜欢我指甲的颜色嘛，猜猜看是用什么染的？.mp3"
  },
  {
   "text": "在我面前你都能睡得着？不如试试永远醒不来怎么样？",
   "file": "voices/在我面前你都能睡得着？不如试试永远醒不来怎么样？.mp3"
  },
  {
   "text": "明日方舟",
   "file": "voices/明日方舟.mp3"
  },
  {
   "text": "砰！是谁告诉你，我每次都会倒数的？",
   "file": "voices/砰！是谁告诉你，我每次都会倒数的？.mp3"
  },
  {
   "text": "终于活腻味了？",
   "file": "voices/终于活腻味了？.mp3"
  },
  {
   "text": "美好的日子真是怎么过都过不完啊。",
   "file": "voices/美好的日子真是怎么过都过不完啊。.mp3"
  }
