 "voices": [
  {
   "text": "开幕。",
   "file": "voices/开幕。.mp3"
  },
  {
   "text": "瞧好了。",
   "file": "voices/瞧好了。.mp3"
  },
  {
   "text": "光芒啊。",
   "file": "voices/光芒啊。.mp3"
  },
  {
   "text": "别打了！",
   "file": "voices/别打了！.mp3"
  },
  {
   "text": "为你献上。",
   "file": "voices/为你献上。.mp3"
  },
  {
   "text": "亮相啦！",
   "file": "voices/亮相啦！.mp3"
  },
  {
   "text": "换我登场了！",
   "file": "voices/换我登场了！.mp3"
  },
  {
   "text": "噔噔！",
   "file": "voices/噔噔！.mp3"
  },
  {
   "text": "闪耀时刻！",
   "file": "voices/闪耀时刻！.mp3"
  },
  {
   "text": "干什么啊！",
   "file": "voices/干什么啊！.mp3"
  },
  {
   "text": "为我歌颂！",
   "file": "voices/为我歌颂！.mp3"
  },
  {
   "text": "见识下我的实力！",
   "file": "voices/见识下我的实力！.mp3"
  },
  {
   "text": "果然还是离不开我啊。",
   "file": "voices/果然还是离不开我啊。.mp3"
  },
  {
   "text": "救命啊——",
   "file": "voices/救命啊——.mp3"
  },
  {
   "text": "总之先休战…",
   "file": "voices/总之先休战….mp3"
  },
  {
   "text": "让世界热闹起来吧。",
   "file": "voices/让世界热闹起来吧。.mp3"
  },
  {
   "text": "情况不妙呀！",
   "file": "voices/情况不妙呀！.mp3"
  },
  {
   "text": "希望是一次尽兴的旅途。",
   "file": "voices/希望是一次尽兴的旅途。.mp3"
  },
  {
   "text": "欢唱，以我之名！",
   "file": "voices/欢唱，以我之名！.mp3"
  },
  {
   "text": "有趣的东西当然是越多越好。",
   "file": "voices/有趣的东西当然是越多越好。.mp3"
  },
  {
   "text": "我还是没能做到…",
   "file": "voices/我还是没能做到….mp3"
  },
  {
   "text": "意外之喜，就像蛋糕上的王冠。",
   "file": "voices/意外之喜，就像蛋糕上的王冠。.mp3"
  },
  {
   "text": "算是…一种解脱吗？",
   "file": "voices/算是…一种解脱吗？.mp3"
  },
  {
   "text": "别看我…丢人的样子…",
   "file": "voices/别看我…丢人的样子….mp3"
  },
  {
   "text": "哇哦，这地方很适合映影取景。",
   "file": "voices/哇哦，这地方很适合映影取景。.mp3"
  },
  {
   "text": "今晚的通心粉选什么酱好呢…",
   "file": "voices/今晚的通心粉选什么酱好呢….mp3"
  },
  {
   "text": "收下吧。咳…我准许了！",
   "file": "voices/收下吧。咳…我准许了！.mp3"
  },
  {
   "text": "靠自己锻炼得到的力量果然很充实。哼哼，多谢了。",
   "file": "voices/靠自己锻炼得到的力量果然很充实。哼哼，多谢了。.mp3"
  },
  {
   "text": "好无聊啊，没有什么更有趣的事吗？",
   "file": "voices/好无聊啊，没有什么更有趣的事吗？.mp3"
  },
  {
   "text": "好大的雨！等等，水应该不会淹上来吧？",
   "file": "voices/好大的雨！等等，水应该不会淹上来吧？.mp3"
  },
  {
   "text": "唉，人气太高也是一种苦恼，谁让我这么受欢迎呢？",
   "file": "voices/唉，人气太高也是一种苦恼，谁让我这么受欢迎呢？.mp3"
  },
  {
   "text": "茶会是淑女的必修课。如果你想学习茶会礼仪的话，我可以教你喔。",
   "file": "voices/茶会是淑女的必修课。如果你想学习茶会礼仪的话，我可以教你喔。.mp3"
  }
 ],
