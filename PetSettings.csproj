<Project Sdk="Microsoft.NET.Sdk">
  <!-- 设置面板：net48 / WPF（XAML 在代码里，无需 markup compile）。
       编译：dotnet build PetSettings.csproj -c Release
       产物：build\settings\PetSettings.exe（再复制到根目录） -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <AssemblyName>PetSettings</AssemblyName>
    <RootNamespace>PetSettings</RootNamespace>
    <LangVersion>7.3</LangVersion>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <!-- 版本信息：与 Pet.csproj 保持同一组数值 -->
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <InformationalVersion>1.0.0</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <AssemblyTitle>Q Pet 设置</AssemblyTitle>
    <Product>Q Pet</Product>
    <Company>Q Pet contributors</Company>
    <Copyright>MIT License · 2026 Q Pet contributors</Copyright>
    <DebugType>none</DebugType>
    <Optimize>true</Optimize>
    <ApplicationIcon>pet.ico</ApplicationIcon>
    <OutputPath>build\settings\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Settings.cs" />
    <Reference Include="System.Xaml" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="WindowsBase" />
    <Reference Include="PresentationCore" />
    <Reference Include="PresentationFramework" />
  </ItemGroup>
  <ItemGroup>
    <!-- 同 Pet.csproj：没装 .NET Framework 4.8 开发包也能 dotnet build -->
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>
</Project>
