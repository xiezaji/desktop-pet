<Project Sdk="Microsoft.NET.Sdk">
  <!-- 设置面板：net48 / WPF（XAML 在代码里，无需 markup compile）。
       编译：dotnet build PetSettings.csproj -c Release
       产物：build\settings\PetSettings.exe（再复制到根目录） -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <AssemblyName>PetSettings</AssemblyName>
    <RootNamespace>PetSettings</RootNamespace>
    <LangVersion>7.3</LangVersion>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <DebugType>none</DebugType>
    <Optimize>true</Optimize>
    <ApplicationIcon>pet.ico</ApplicationIcon>
    <OutputPath>build\settings\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Settings.cs" />
    <Reference Include="System.Xaml" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="WindowsBase" />
    <Reference Include="PresentationCore" />
    <Reference Include="PresentationFramework" />
  </ItemGroup>
</Project>
